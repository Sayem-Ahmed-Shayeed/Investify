# DigitalOcean Spaces Configuration
DO_SPACES_KEY=your_spaces_access_key_here
DO_SPACES_SECRET=your_spaces_secret_key_here
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=your-bucket-name
DO_SPACES_REGION=nyc3

# MongoDB Atlas Configuration
# Get your connection string from MongoDB Atlas Dashboard:
# 1. Go to Database > Connect > Connect your application
# 2. Copy the connection string and replace <password> with your actual password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/investify?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=production

# Firebase Admin SDK (for token verification)
# Download your service account key from Firebase Console
# and save it as firebase-service-account.json in the backend folder
FIREBASE_PROJECT_ID=your-firebase-project-id

# Security
JWT_SECRET=generate_a_strong_random_string_here
ALLOWED_ORIGINS=https://your-app-domain.com

# Upload limits (in bytes)
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=104857600
